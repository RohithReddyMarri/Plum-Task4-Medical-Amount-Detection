# Application Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# AI / LLM Integration (Optional)
# If provided, the pipeline leverages Gemini for advanced entity semantic extraction and validation.
# If omitted or left empty, the pipeline operates 100% locally via RapidOCR + regex normalizer + contextual parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OCR Settings
OCR_CONFIDENCE_THRESHOLD=0.50
NOISY_DOCUMENT_THRESHOLD=0.30
